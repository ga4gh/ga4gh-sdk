Hand edits of the WES 1.1.0 models, applied by utils/build_models.sh.

The generator merges the `anyOf` items of `RunListResponse.runs` and
`RunLog.task_logs` into one struct that has the required fields of both
variants. These edits make the fields optional that only one variant has
(`tags`; `name` and `id`), so that `RunStatus` and `Log` items parse. They
also read the nullable `task_logs` as a plain `Option`, which needs no
`serde_with` dependency.

--- a/models/run_list_response_runs_inner.rs
+++ b/models/run_list_response_runs_inner.rs
@@ -26,18 +26,19 @@
     #[serde(rename = "end_time", skip_serializing_if = "Option::is_none")]
     pub end_time: Option<String>,
     /// Arbitrary key/value tags added by the client during run creation
-    #[serde(rename = "tags")]
-    pub tags: std::collections::HashMap<String, String>,
+    /// Optional here: `RunStatus` items, which the spec also allows, have no tags.
+    #[serde(rename = "tags", skip_serializing_if = "Option::is_none")]
+    pub tags: Option<std::collections::HashMap<String, String>>,
 }
 
 impl RunListResponseRunsInner {
-    pub fn new(run_id: String, tags: std::collections::HashMap<String, String>) -> RunListResponseRunsInner {
+    pub fn new(run_id: String) -> RunListResponseRunsInner {
         RunListResponseRunsInner {
             run_id,
             state: None,
             start_time: None,
             end_time: None,
-            tags,
+            tags: None,
         }
     }
 }
