Hand edits of the TES 1.1.0 models, applied by utils/build_models.sh.

- `TesTask.executors` stays optional, so that task views without executors
  (for example `MINIMAL`) parse.
- `ListTasksParams` is hand-written and lives in
  `lib/src/clients/tes/list_tasks_params.rs`; `models` re-exports it.

--- a/models/mod.rs
+++ b/models/mod.rs
@@ -32,3 +32,5 @@
 pub use self::tes_task::TesTask;
 pub mod tes_task_log;
 pub use self::tes_task_log::TesTaskLog;
+// Hand-written, outside `models/`; re-exported for the existing import path.
+pub use crate::clients::tes::list_tasks_params::ListTasksParams;
--- a/models/tes_task.rs
+++ b/models/tes_task.rs
@@ -37,7 +37,7 @@
